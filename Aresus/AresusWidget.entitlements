<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's App Group (the saved widget status) and Keychain group (the shared Empire token the widget reads;
     it never logs in or renews). Needs the paid team on a device; the simulator embeds them as simulated entitlements. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.ares-empire.shared</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.ares-empire.shared</string>
	</array>
</dict>
</plist>
