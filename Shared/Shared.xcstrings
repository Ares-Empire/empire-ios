      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falsches Passwort."
          }
        }
      }
    },
    "You stay logged in here. The other Ares apps on this iPhone follow when you open them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bleibst hier angemeldet. Die anderen Ares-Apps auf diesem iPhone folgen, sobald du sie öffnest."
          }
        }
      }
    },
    "You'll be logged out of all Ares apps on this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst in allen Ares-Apps auf diesem iPhone abgemeldet."
          }
        }
      }
    },
    "You'll be logged out of all Ares apps on this iPhone. Your data in %@ stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst in allen Ares-Apps auf diesem iPhone abgemeldet. Deine Daten in %@ bleiben."
          }
        }
      }
    },
    "Your %@ data on its server is deleted, but your access is not removed yet. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten in %@ sind auf dem Server gelöscht, aber dein Zugang ist noch nicht entfernt. %@"
