        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Link ist unterwegs an %@. Öffne ihn, um deine Adresse zu bestätigen. Dann gibt Patrik dein Konto frei, und eine E-Mail sagt dir, sobald es bereit ist."
          }
        }
      }
    },
