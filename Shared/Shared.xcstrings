    "%@ and its data on this iPhone stay, as do your Ares account and the other apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und die Daten der App auf diesem iPhone bleiben, ebenso dein Ares-Konto und die anderen Apps."
