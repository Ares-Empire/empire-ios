        }
      }
    },
    "Your Ares account and the other apps stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ares-Konto und die anderen Apps bleiben."
          }
        }
      }
    },
    "Your Ares account and the other apps stay. You can ask for access again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ares-Konto und die anderen Apps bleiben. Du kannst später wieder Zugang anfragen."
          }
        }
      }
    },
    "Your Ares account is deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ares-Konto ist gelöscht."
          }
        }
      }
    },
    "Your access and your data in %@ go. Your Ares account stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Zugang zu %@ und deine Daten dort werden entfernt. Dein Ares-Konto bleibt."
          }
        }
      }
    },
    "Your account and its data in every Ares app go for good." : {
      "localizations" : {
        "de" : {
