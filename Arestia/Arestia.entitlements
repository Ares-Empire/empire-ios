<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Arestia's own App Group (the devices' names, the app's language for its controls) and Keychain group
     (the pairing: flatd's address and key), shared with its Control Center extension (ArestiaShared/FlatdConnection.swift). Arestia has no Ares
     account (Patrik, 2026-11-19: "no account needed, just me"), so it is not in the Empire's shared login groups
     (docs/ARESTIA-APP.md). Needs the paid team on a device; the simulator embeds them as simulated entitlements. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.ares-empire.arestia</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.ares-empire.arestia</string>
	</array>
</dict>
</plist>
