    "Arestia forgets the key and the address. The Control Center controls and Shortcuts stop until you connect again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arestia vergisst den Schlüssel und die Adresse. Die Steuerelemente im Kontrollzentrum und die Kurzbefehle gehen erst wieder, wenn du dich neu verbindest."
          }
        }
      }
    },
    "Arestia may not use the local network. Allow it in iOS Settings → Privacy → Local Network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arestia darf das lokale Netzwerk nicht nutzen. Erlaube es in den iOS-Einstellungen → Datenschutz → Lokales Netzwerk."
          }
        }
      }
    },
