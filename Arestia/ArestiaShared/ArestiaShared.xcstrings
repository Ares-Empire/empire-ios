    },
    "On · not all followed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An · nicht alle gefolgt"
          }
        }
      }
    },
    "Open" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offen"
          }
        }
      }
    },
    "Position unknown" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position unbekannt"
          }
        }
      }
    },
    "Sends a blind up or down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fährt ein Rollo hoch oder runter."
          }
        }
      }
    },
    "Sends a blind up, down, to its favourite spot, or stops it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fährt ein Rollo hoch, runter, auf seinen Favoriten, oder hält es an."
          }
        }
      }
    },
    "Sends every blind down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fährt alle Rollos runter."
          }
        }
      }
    },
    "Start cooking" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen starten"
          }
        }
      }
    },
    "Start or end cooking: the fans and the blind together." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen starten oder beenden: Ventilatoren und Rollo zusammen."
          }
        }
      }
    },
    "Stop" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopp"
          }
        }
      }
    },
    "That isn't possible right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geht gerade nicht."
          }
        }
      }
    },
    "The device didn't confirm it. Its state shows once flatd reads it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät hat es nicht bestätigt. Sein Zustand zeigt sich, sobald flatd es wieder liest."
          }
        }
      }
    },
    "The fans run for 30 minutes and a blind goes up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ventilatoren laufen 30 Minuten, und ein Rollo fährt hoch."
          }
        }
      }
    },
    "The flat service couldn't do it (%lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst konnte es nicht ausführen (%lld)."
          }
        }
      }
    },
    "The flat service didn't answer in time. It may still have done it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst hat nicht rechtzeitig geantwortet. Vielleicht hat er es trotzdem ausgeführt."
          }
        }
      }
    },
    "The flat service doesn't know this any more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst kennt das nicht mehr."
          }
        }
      }
    },
    "The flat service refused the key. Pair again in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst lehnt den Schlüssel ab. Kopple in den Einstellungen neu."
          }
        }
      }
    },
    "The flat service sent an answer this app can't read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst hat eine Antwort geschickt, die diese App nicht lesen kann."
          }
        }
      }
    },
    "This blind isn't in your flat anymore. Choose it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Rollo ist nicht mehr in deiner Wohnung. Wähl es neu."
          }
        }
      }
    },
    "This fan isn't in your flat anymore. Choose it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ventilator ist nicht mehr in deiner Wohnung. Wähl ihn neu."
          }
        }
      }
    },
    "This is a different flat. Forget the current one first: Settings → Forget this flat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist eine andere Wohnung. Vergiss zuerst die jetzige: Einstellungen → Diese Wohnung vergessen."
          }
        }
      }
    },
    "To its favourite spot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Favoriten"
          }
        }
      }
    },
    "Turns on cooking: the fans run and its blind goes up, until you end it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet das Kochen: Die Ventilatoren laufen und sein Rollo fährt hoch, bis du es beendest."
          }
        }
      }
    },
    "Turns the fans off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet die Ventilatoren aus."
          }
        }
      }
    },
    "Turns the fans on, for a while or until you turn them off. The timer runs in the plug, so it ends even when the Mac sleeps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet die Ventilatoren ein, für eine Weile oder bis du sie ausschaltest. Den Timer führt die Steckdose, er endet also auch, wenn der Mac schläft."
          }
        }
      }
    },
    "Up" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoch"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
