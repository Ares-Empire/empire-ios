      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopp"
          }
        }
      }
    },
    "That isn't possible right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geht gerade nicht."
          }
        }
      }
    },
    "The device didn't answer. Nothing changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät hat nicht geantwortet. Nichts hat sich geändert."
          }
        }
      }
    },
    "The fans run for 30 minutes and a blind goes up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ventilatoren laufen 30 Minuten, und ein Rollo fährt hoch."
          }
        }
      }
    },
    "The flat service couldn't do it (%lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst konnte es nicht ausführen (%lld)."
          }
        }
      }
    },
    "The flat service didn't answer in time. It may still have done it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst hat nicht rechtzeitig geantwortet. Vielleicht hat er es trotzdem ausgeführt."
          }
        }
      }
    },
    "The flat service doesn't know this any more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst kennt das nicht mehr."
          }
        }
      }
    },
    "The flat service refused the key. Pair again in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst lehnt den Schlüssel ab. Kopple in den Einstellungen neu."
          }
        }
      }
    },
    "The flat service sent an answer this app can't read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wohnungsdienst hat eine Antwort geschickt, die diese App nicht lesen kann."
          }
        }
      }
    },
    "To its favourite spot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf den Favoriten"
          }
        }
      }
    },
    "Turns on cooking: the fans run and its blind goes up, until you end it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet das Kochen: Die Ventilatoren laufen und sein Rollo fährt hoch, bis du es beendest."
          }
        }
      }
    },
    "Turns the fans off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet die Ventilatoren aus."
          }
        }
      }
    },
    "Turns the fans on, for a while or until you turn them off. The timer runs in the plug, so it ends even when the Mac sleeps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet die Ventilatoren ein, für eine Weile oder bis du sie ausschaltest. Den Timer führt die Steckdose, er endet also auch, wenn der Mac schläft."
          }
        }
      }
    },
    "Up" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoch"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
