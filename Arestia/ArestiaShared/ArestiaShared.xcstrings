{
  "sourceLanguage" : "en",
  "strings" : {
    "%@: %@." : {
      "shouldTranslate" : false
    },
    "Air out" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lüften"
          }
        }
      }
    },
    "Airing out for 30 minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird 30 Minuten gelüftet."
          }
        }
      }
    },
    "All blinds are going down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Rollos fahren runter."
          }
        }
      }
    },
    "All blinds down" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Rollos runter"
          }
        }
      }
    },
    "Arestia couldn't read its pairing just now. Unlock the iPhone and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arestia konnte seine Kopplung gerade nicht lesen. Entsperre das iPhone und versuch es noch einmal."
          }
        }
      }
    },
    "Arestia isn't paired with a flat. Open Arestia to pair it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arestia ist mit keiner Wohnung gekoppelt. Öffne Arestia, um sie zu koppeln."
          }
        }
      }
    },
    "Blind" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollo"
          }
        }
      }
    },
    "Blind up or down" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollo hoch oder runter"
          }
        }
      }
    },
    "Can't reach the flat. The Mac may be asleep, or you're not at home." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wohnung ist nicht erreichbar. Der Mac schläft vielleicht, oder du bist nicht zu Hause."
          }
        }
      }
    },
    "Choose a blind" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rollo wählen"
          }
        }
      }
    },
