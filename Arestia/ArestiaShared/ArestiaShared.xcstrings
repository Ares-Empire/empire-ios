      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kochen beenden"
          }
        }
      }
    },
    "Ends cooking: the fans go off and its blind goes to its favourite spot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
