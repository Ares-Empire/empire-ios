      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runter"
          }
        }
      }
    },
    "Empty: every fan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer: alle Ventilatoren."
          }
        }
