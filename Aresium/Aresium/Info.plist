<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE). Only what build settings cannot express. -->
<plist version="1.0">
<dict>
    <key>UILaunchScreen</key>
    <dict><key>UIColorName</key><string>LaunchBackground</string></dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>de.ares-empire.aresium</string>
            <key>CFBundleURLSchemes</key>
            <array><string>aresium</string></array>
        </dict>
    </array>
	<!-- Bank (VR Bank) and PayPal exports: lets the share sheet offer "Aresium" for .csv and CAMT .xml files. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Bank or PayPal export</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.xml</string>
			</array>
		</dict>
	</array>
	<!-- Only standard HTTPS: exempt, so App Store Connect stops asking about encryption on every build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
