<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE). Only what build settings cannot express. -->
<plist version="1.0">
<dict>
    <key>UILaunchScreen</key>
    <dict><key>UIColorName</key><string>LaunchBackground</string></dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>de.ares-empire.aresium</string>
            <key>CFBundleURLSchemes</key>
            <array><string>aresium</string></array>
        </dict>
    </array>
	<!-- Bank and PayPal exports: lets the share sheet offer "Aresium" for .csv, CAMT .xml and MT940 (.sta, .mt940)
	     files. Not .txt: a .txt file is plain text to iOS, which has no narrower type for MT940 inside one, so Aresium
	     would be offered for every text file; .txt statements are picked inside the app instead (PhoneImportTypes).
	     Not .zip (brief 204): the engine reads no ZIP, it only says to unzip it first, so Aresium would be offered for
	     every zip just to refuse it. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Bank or PayPal export</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
				<string>public.xml</string>
				<string>de.ares-empire.aresium.mt940</string>
				<string>public.zip-archive</string>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
				<string>com.microsoft.excel.xls</string>
			</array>
		</dict>
	</array>
	<!-- MT940 has no system type: imported (Aresium does not own the format) for the extensions banks use. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.ares-empire.aresium.mt940</string>
			<key>UTTypeDescription</key>
			<string>MT940 bank statement</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sta</string>
					<string>mt940</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Settings → Lock: Face ID unlocks Aresium (Model/AppLock.swift). German in InfoPlist.xcstrings. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks Aresium when you turn on its lock.</string>
	<!-- Import → Scan receipt: Apple's document scanner (Screens/ReceiptCaptureScreens.swift). German in
	     InfoPlist.xcstrings. -->
	<key>NSCameraUsageDescription</key>
	<string>The camera scans your receipts. The photo stays on this iPhone and is not kept.</string>
	<!-- The team prefix of the shared Keychain group (Shared/EmpireShared.swift). -->
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<!-- Only standard HTTPS: exempt, so App Store Connect stops asking about encryption on every build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
