<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Apple privacy manifest (Aresium app). What it declares and why: ares-empire/docs/PRIVACY.md and
     docs/APP-STORE.md. Update it when the app sends something new or starts using another required-reason API
     (https://developer.apple.com/documentation/bundleresources/privacy-manifest-files). -->
<plist version="1.0">
<dict>
	<!-- No tracking: no analytics, ads or third-party SDKs; data goes only to the Empire's own servers. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: this app's own defaults (ContentView's @AppStorage: the remembered theme;
				     Shared/Language/LanguageSetting.swift: the app's language; Model/ModeStore.swift: each
				     account's mode, server or phone). -->
				<string>CA92.1</string>
				<!-- 1C8F.1: the App Groups' defaults (Shared/EmpireShared.swift: the first-launch flag;
				     Shared/Language/WidgetLanguage.swift: the language choice for the widgets; the login marker,
				     Shared/Auth/LoginMarker.swift; the push device record, Shared/Push/PushDeviceStore.swift). -->
				<string>1C8F.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: files inside the app's own container. Model/PhoneStore.swift (`PhoneStorage.oldStores`) reads
				     when an older per-account store last changed, to move the most recent one over as this iPhone's
				     store (brief 22). -->
				<string>C617.1</string>
			</array>
		</dict>
	</array>
	<!-- Used only to run the app. The account (email, name, user id) only for someone who signs in, which Aresium does not
	     need (brief 22: only for an Aresium server of one's own); Contact & support without a login sends the email and
	     the optional name typed into the form (the account server's `contact` collection). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Email address: the Empire login (Shared/Auth), kept by the account server; or the address typed into Contact &
		     support without a login (Shared/Support, `ContactMessage`), so Patrik can answer. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Name: optional in Contact & support without a login (Shared/Support), kept by the account server. (Aresium no
		     longer creates accounts; another Ares app's sign-up may have asked for it.) -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- User ID: the Empire account id; every request carries the login token that names it. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- No financial info: other people's bank data stays on their iPhone (phone mode); server mode is only the
		     owner's own data. Why: docs/APP-STORE.md. -->
		<!-- Customer support: the Contact & support form (Shared/Support, brief E5): message, app and iOS version, language. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCustomerSupport</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
