          }
        }
      }
    },
    "An export can only be restored while Aresium has no data on this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Export lässt sich nur wiederherstellen, solange Aresium auf diesem iPhone keine Daten hat."
          }
        }
      }
