        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann zählt sie nur unter %@."
          }
        }
      }
    },
    "Then show Aresium where things are in your file. The payments below follow your answers." : {
      "localizations" : {
