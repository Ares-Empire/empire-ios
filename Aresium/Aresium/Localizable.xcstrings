            "value" : "Auch in"
          }
        }
      }
    },
    "Also show this under other categories. It stays counted once (in %@), so nothing is double-counted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig das auch unter anderen Kategorien. Gezählt wird es nur einmal (in %@), nichts wird doppelt gezählt."
          }
