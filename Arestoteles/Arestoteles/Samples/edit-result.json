      {
        "summary": "Movable type made copying cheap, and cheap copies changed who could argue in public. The press did not cause the Reformation alone, but it made it impossible to stop.",
        "confidence": "my-read",
        "created": "2026-10-01",
        "updated": "2026-10-24",
        "tags": [
          "media",
          "europe"
        ],
        "topic": "Printing press",
        "part_of": null,
        "event": null,
