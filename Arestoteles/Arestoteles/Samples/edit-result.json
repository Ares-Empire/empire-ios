      {
        "summary": "When copying gets cheaper, the most copied ideas win, not the best ones.",
        "confidence": "my-read",
        "created": "2026-10-01",
        "updated": "2026-10-20",
        "tags": [],
        "topic": null,
        "part_of": null,
        "event": null,
        "led_to": [],
        "links": [],
        "backlinks": [
          "Positions",
          "Printing press",
          "Reformation"
        ],
        "positions": [],
        "callouts": [],
        "blocks": [
          {
            "kind": "paragraph",
            "text": "Each drop in the cost of copying (print, the telegraph, the web) moved power from those who control the copies to those who get read."
          },
          {
            "kind": "heading",
            "level": 2,
            "text": "My take",
            "anchor": "My take"
          },
          {
            "kind": "paragraph",
            "text": "The printers were businessmen first: they printed Luther because Luther sold."
          }
        ],
