          }
        }
      }
    },
    "Every text written automatically includes these points. Only your notes and the facts about you are used, nothing is made up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder automatisch geschriebene Text enthält diese Punkte. Verwendet werden nur deine Hinweise und die Angaben über dich, erfunden wird nichts."
